# Cloud Functions runtime values. Copy to functions/.env for deployment.
APP_BASE_URL=https://erp.example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-gmail@gmail.com
SMTP_FROM="NEXORA ERP <your-gmail@gmail.com>"
# Do not place SMTP_PASSWORD in this file. Store it with Firebase Secret Manager.
