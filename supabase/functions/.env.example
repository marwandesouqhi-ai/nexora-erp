# Secrets for Supabase Edge Functions (the replacement for functions/.env).
# Copy to supabase/functions/.env for local runs (gitignored).
# In the cloud project, set them with: npx supabase secrets set --env-file supabase/functions/.env
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected automatically.

APP_BASE_URL=http://localhost:5173

# Invitation / password emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="NEXORA ERP <no-reply@example.com>"

# WhatsApp (UltraMsg); moved server-side so the token is no longer in the browser bundle
ULTRAMSG_INSTANCE_ID=
ULTRAMSG_TOKEN=

# AI assistant (ai-proxy function); replaces the VITE_GEMINI_API_KEY in the browser
GEMINI_API_KEY=
GEMINI_MODEL=
